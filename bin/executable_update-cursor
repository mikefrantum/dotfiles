#!/bin/bash
echo "Fetching latest Cursor version..."
DOWNLOAD_URL=$(curl -sL "https://cursor.com/api/download?platform=linux-x64&releaseTrack=stable" | grep -o '"downloadUrl":"[^"]*"' | cut -d'"' -f4)
echo "Downloading $DOWNLOAD_URL"
curl -L -o ~/.local/share/appimages/cursor.AppImage "$DOWNLOAD_URL"
chmod +x ~/.local/share/appimages/cursor.AppImage
echo "Done — Cursor updated."
